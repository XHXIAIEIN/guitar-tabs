\title "遇见"
\artist "孙燕姿"
\tempo 88
\ts 4 4
\ks C
\systemsLayout (3 2 2 2 2 2 2 2)
\instructions "从第 4 拍弱起。主歌在开放把位的 1 到 3 弦；高音在 1、2 弦的 7 到 12 品，左手 {1} 放在第 7 品，休止时换把。"

\section "主歌" \ac 3.1.8 0.1 |
-.1.4{ch "C"} 3.1.8 3.2.4{d ch "G"} 0.1.8 3.2 | -.2.8{ch "Am"} 1.2.2 r.8 1.2 0.2 |
2.3.8{ch "F"} 0.2 1.2 0.2.4{ch "G"} 1.2.8 3.2 0.1 | -.1.2{d ch "C"} 3.1.8 0.1 |
-.1.4{ch "C"} 8.2.8 10.1.4{d ch "G"} 8.1.8 7.1 | -.1.8{ch "Am"} 8.1.2 r.8 1.2 0.2 |
2.3.8{ch "F"} 0.2 1.2 0.2.4{ch "G"} 1.2.8 3.2.4 | 1.2.2{ch "C"} r.8 8.2 10.2 7.1 |

\section "副歌" 8.1.4{ch "F"} 7.1.8 8.1 7.1{ch "G"} 10.2 8.2 10.2 | -.2.8{ch "C"} 8.2.4{d} r.8 1.2 3.2 0.1 |
1.1.4{ch "Dm"} 0.1.8 1.1 3.1{ch "G"} 1.2 3.2 0.1 | -.1.8{ch "C"} 0.1.4{d} r.8 8.2 10.2 7.1 |
